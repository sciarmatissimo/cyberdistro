#!/bin/sh
# Install Kali-provided tools. The Kali archive is added by live-build from
# config/archives/ (key verified at build time), so it is available for the
# whole chroot stage, and live-build removes it cleanly afterwards.
#
# TOLERANT: each package installs on its own; a missing/broken one is logged and
# skipped so it never aborts the ISO build. We use --install-recommends here
# because the global build default is --apt-recommends false, and tools like
# ghidra/zaproxy need their recommended runtime (e.g. a JRE) to actually work.
set -e

echo "I: installing Kali-provided tools"
apt-get update || true

# Light Kali tools baked into the image. The heavy, Java-based ones (ghidra,
# zaproxy) are NOT baked — they would push the ISO over GitHub's 2 GiB release
# limit — and are offered as a one-click on-demand install instead
# (cyberdistro-install-kali-tool + desktop launchers).
TOOLS="radare2 rizin zeek wapiti bulk-extractor"

for p in $TOOLS; do
    if apt-get install -y --install-recommends "$p"; then
        echo "I: installed $p"
    else
        echo "W: could not install '$p' — left out of this image"
    fi
done

echo "I: Kali tools step done"
