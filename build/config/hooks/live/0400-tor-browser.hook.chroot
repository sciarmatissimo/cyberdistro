#!/bin/sh
# Fetch and GPG-verify the official Tor Browser (best-effort, NON-FATAL).
# We do NOT modify Tor Browser internals (that would weaken fingerprint
# resistance). If download OR verification fails, we SKIP it without aborting
# the build: the `tor` daemon + torsocks are already installed, and the Security
# Center can offer Tor Browser as a verified first-run download.
set -u

TBB_VERSION="${TBB_VERSION:-15.0.26}"
ARCH="linux-x86_64"
BASE="https://dist.torproject.org/torbrowser/${TBB_VERSION}"
PKG="tor-browser-${ARCH}-${TBB_VERSION}.tar.xz"

cd /tmp || exit 0
echo "I: trying to fetch Tor Browser ${TBB_VERSION} (non-fatal)"
if ! wget -q "${BASE}/${PKG}" || ! wget -q "${BASE}/${PKG}.asc"; then
    echo "W: Tor Browser ${TBB_VERSION} not downloaded; skipping (offered at first run)."
    exit 0
fi

export GNUPGHOME=$(mktemp -d)
if ! gpg --auto-key-locate nodefault,wkd --locate-keys torbrowser@torproject.org 2>/dev/null \
    && ! gpg --keyserver keyserver.ubuntu.com \
         --recv-keys EF6E286DDA85EA2A4BA7DE684E2C6E8793298290 2>/dev/null; then
    echo "W: could not fetch Tor signing key; skipping Tor Browser."
    rm -rf "$GNUPGHOME" "${PKG}" "${PKG}.asc"; exit 0
fi

if gpg --verify "${PKG}.asc" "${PKG}" 2>/dev/null; then
    command -v xz >/dev/null 2>&1 || apt-get install -y --no-install-recommends xz-utils >/dev/null 2>&1 || true
    mkdir -p /opt/tor-browser
    if tar -xJf "${PKG}" -C /opt/tor-browser --strip-components=1 \
       && [ -x /opt/tor-browser/Browser/start-tor-browser ]; then
        # The tarball is extracted by root with 0700 modes: make it world-
        # readable so the live user can copy it into $HOME on first launch
        # (Tor Browser must own a writable copy: it keeps its profile and
        # updates inside its own directory; /opt stays a pristine template).
        chmod -R a+rX /opt/tor-browser
        echo "I: Tor Browser verified and installed to /opt/tor-browser (template)"
    else
        echo "W: Tor Browser extraction failed; NOT bundled (skipped)."
        rm -rf /opt/tor-browser
    fi
else
    echo "W: Tor Browser signature check failed; NOT bundled (skipped)."
fi
rm -rf "$GNUPGHOME" "${PKG}" "${PKG}.asc"
exit 0
