#!/bin/sh
# Optionally remove firmware for enterprise/datacenter hardware that a portable
# USB security workstation will not use, to make room (e.g. when bundling the
# local AI model and staying under the 2 GiB GitHub release-asset limit).
#
# Gated by a marker staged by build.sh when CYBERDISTRO_TRIM_FIRMWARE=1, so
# default builds are completely untouched. Each package is purged only if
# installed, and failures are tolerated so a single package never aborts the
# build. Wi-Fi, GPU, Bluetooth and common laptop/desktop firmware are kept.
set -e

[ -f /etc/cyberdistro/trim-firmware ] || { echo "I: firmware trim not requested"; exit 0; }

echo "I: trimming unused enterprise/datacenter firmware"

# Standalone firmware packages for server-class NICs/accelerators unlikely on a
# portable workstation. Conservative, curated list.
PKGS="firmware-bnx2 firmware-bnx2x firmware-qlogic firmware-netxen \
firmware-cavium firmware-myricom firmware-netronome firmware-liquidio"

for p in $PKGS; do
    if dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed"; then
        echo "I:   purging $p"
        apt-get purge -y "$p" >/dev/null 2>&1 || echo "W:   could not purge $p (kept)"
    fi
done

apt-get autoremove -y >/dev/null 2>&1 || true
echo "I: firmware trim done"
