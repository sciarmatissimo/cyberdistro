#!/bin/sh
# Set up the Kali archive INSIDE the chroot so Kali-provided tools can be
# installed by later hooks. This runs as a chroot hook; it writes the key, the
# source and the pinning itself rather than relying on includes.chroot timing
# (which is applied after the package-list install pass).
set -e

echo "I: configuring Kali archive (key + source + pinning)"
EXPECTED="827C8569F2518CC677FECA1AED65462EC8D5E4C5"

# 1) Key → /usr/share/keyrings/kali-archive-keyring.gpg
if apt-get install -y --no-install-recommends kali-archive-keyring 2>/dev/null; then
    [ -f /usr/share/keyrings/kali-archive-keyring.gpg ] || \
    cp /etc/apt/trusted.gpg.d/kali-archive-keyring.gpg \
       /usr/share/keyrings/kali-archive-keyring.gpg 2>/dev/null || true
fi
if [ ! -f /usr/share/keyrings/kali-archive-keyring.gpg ]; then
    echo "I: fetching Kali key by fingerprint"
    tmpkey=$(mktemp)
    if wget -qO "$tmpkey" https://archive.kali.org/archive-keyring.gpg; then
        if gpg --show-keys --with-fingerprint "$tmpkey" | grep -q "$EXPECTED"; then
            cp "$tmpkey" /usr/share/keyrings/kali-archive-keyring.gpg
        else
            echo "E: Kali key fingerprint mismatch"; rm -f "$tmpkey"; exit 1
        fi
    else
        echo "W: could not fetch Kali key (no network?). Kali tools will be skipped."
        rm -f "$tmpkey"
        exit 0   # non-fatal: base Debian image still builds
    fi
    rm -f "$tmpkey"
fi

# 2) Source (pinned LOW via preferences below)
mkdir -p /etc/apt/sources.list.d
cat > /etc/apt/sources.list.d/kali.list <<'EOF'
deb [signed-by=/usr/share/keyrings/kali-archive-keyring.gpg] http://http.kali.org/kali kali-rolling main contrib non-free non-free-firmware
EOF

# 3) Pinning: Debian stays the system of record (990), Kali installable (100)
mkdir -p /etc/apt/preferences.d
cat > /etc/apt/preferences.d/kali <<'EOF'
Package: *
Pin: release o=Debian
Pin-Priority: 990

Package: *
Pin: release o=Kali
Pin-Priority: 100
EOF

apt-get update || echo "W: apt-get update after adding Kali returned non-zero"
