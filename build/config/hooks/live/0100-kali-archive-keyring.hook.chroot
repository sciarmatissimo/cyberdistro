#!/bin/sh
# Set up the Kali archive INSIDE the chroot so Kali-provided tools can be
# installed by hook 0600. Runs as a chroot hook and writes key+source+pinning
# itself (includes.chroot is applied too late for the package-install pass).
#
# NON-FATAL: if the key cannot be fetched or verified, we SKIP Kali setup and
# exit 0, so the base Debian ISO still builds. Kali tools are then simply absent
# (hook 0600 tolerates that), and the Security Center reports what is installed.
set -e

# Official Kali archive signing key fingerprint (key ID ED444FF07D8D0BF6).
EXPECTED="44C6513A8E4FB3D30875F758ED444FF07D8D0BF6"

echo "I: configuring Kali archive (key + source + pinning)"

keyfile=/usr/share/keyrings/kali-archive-keyring.gpg
have_key=no

# Try the packaged keyring first (not in Debian, but harmless to attempt).
if apt-get install -y --no-install-recommends kali-archive-keyring 2>/dev/null; then
    if [ -f "$keyfile" ]; then
        have_key=yes
    elif [ -f /etc/apt/trusted.gpg.d/kali-archive-keyring.gpg ]; then
        cp /etc/apt/trusted.gpg.d/kali-archive-keyring.gpg "$keyfile"; have_key=yes
    fi
fi

# Fallback: fetch the key and verify its fingerprint (parsed with --with-colons
# so there are no spaces to trip the comparison).
if [ "$have_key" = no ]; then
    echo "I: fetching Kali key and verifying fingerprint"
    tmpkey=$(mktemp)
    if wget -qO "$tmpkey" https://archive.kali.org/archive-keyring.gpg; then
        got=$(gpg --show-keys --with-colons "$tmpkey" 2>/dev/null \
              | awk -F: '/^fpr:/{print $10; exit}')
        if [ "$got" = "$EXPECTED" ]; then
            cp "$tmpkey" "$keyfile"; have_key=yes
            echo "I: Kali key verified ($got)"
        else
            echo "W: Kali key fingerprint mismatch (got '${got:-none}'); skipping Kali."
        fi
    else
        echo "W: could not download Kali key (no network?); skipping Kali."
    fi
    rm -f "$tmpkey"
fi

if [ "$have_key" = no ]; then
    echo "W: Kali archive NOT configured; base image builds without Kali tools."
    exit 0
fi

mkdir -p /etc/apt/sources.list.d /etc/apt/preferences.d
cat > /etc/apt/sources.list.d/kali.list <<'EOF'
deb [signed-by=/usr/share/keyrings/kali-archive-keyring.gpg] http://http.kali.org/kali kali-rolling main contrib non-free non-free-firmware
EOF
cat > /etc/apt/preferences.d/kali <<'EOF'
Package: *
Pin: release o=Debian
Pin-Priority: 990

Package: *
Pin: release o=Kali
Pin-Priority: 100
EOF

apt-get update || echo "W: apt-get update after adding Kali returned non-zero"
echo "I: Kali archive configured."
