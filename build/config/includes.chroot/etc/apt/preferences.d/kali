# APT pinning — CyberDistro
# Debian stable is the system of record. Kali provides tools on explicit request.
#
# Effect:
#   - Debian packages win by default (priority 990).
#   - Kali packages are installable explicitly (apt install -t kali-rolling pkg,
#     or simply apt install pkg when the package exists only in Kali), but a
#     plain `apt upgrade` will NOT pull the Kali rolling base over Debian stable.

Package: *
Pin: release o=Debian
Pin-Priority: 990

Package: *
Pin: release o=Kali
Pin-Priority: 100
