#!/bin/sh
# live-build auto/config — CyberDistro
# Executed by `lb config`. Defines distribution, archives, bootloaders.
# Reference: live-build (Debian Live). Run from the build/ directory.

set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --linux-flavours amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer none \
    --bootloaders "grub-efi grub-pc" \
    --uefi-secure-boot disable \
    --iso-application "CyberDistro" \
    --iso-publisher "CyberDistro Project" \
    --iso-volume "CyberDistro-$(cat ../VERSION 2>/dev/null || echo 0.1.0)" \
    --memtest none \
    --apt-recommends false \
    --apt-indices false \
    --firmware-chroot true \
    --firmware-binary true \
    --win32-loader false \
    --bootappend-live "boot=live components quiet splash noeject username=analyst hostname=cyberdistro" \
    "${@}"

# Kali repository is added (as a secondary, pinned-low archive) via a hook and
# the apt sources/preferences shipped under config/includes.chroot/etc/apt.
# We do NOT set Kali as the primary distribution: the base OS stays Debian stable.
