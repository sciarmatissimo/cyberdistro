# CyberDistro Sentinel Lite — light desktop on top of the Sentinel (Kiosk) list.
# LXQt has no Wayland session in Debian 13, so it runs on Xorg. Measured with
# the trixie indexes (no Recommends): about +135 MB of .deb, Firefox included.

# --- Xorg (modesetting is built into xserver-xorg-core; fbdev/vesa as fallbacks)
xserver-xorg-core
xserver-xorg-input-libinput
xserver-xorg-video-fbdev
xserver-xorg-video-vesa
xinit
xauth
dbus-user-session

# --- LXQt desktop with the xfwm4 window manager (+10 MB, lighter than openbox
# here because openbox pulls Ghostscript)
lxqt-session
lxqt-session-l10n
lxqt-panel
lxqt-panel-l10n
lxqt-runner
lxqt-runner-l10n
lxqt-config
lxqt-config-l10n
lxqt-policykit
lxqt-policykit-l10n
lxqt-notificationd
lxqt-notificationd-l10n
lxqt-powermanagement
lxqt-powermanagement-l10n
lxqt-globalkeys
lxqt-globalkeys-l10n
lxqt-qtplugin
lxqt-themes
liblxqt-l10n
breeze-icon-theme
# SVG image plugin: the panel menu button icon is an SVG file (blank without it)
qt6-svg-plugins
xfwm4

# --- everyday apps
pcmanfm-qt
pcmanfm-qt-l10n
libfm-qt-l10n
qterminal
qterminal-l10n
featherpad
featherpad-l10n
nm-tray
nm-tray-l10n
firefox-esr
firefox-esr-l10n-it
