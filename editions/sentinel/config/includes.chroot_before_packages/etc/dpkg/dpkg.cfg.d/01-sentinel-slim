# CyberDistro Sentinel: keep the ISO small. Documentation, man pages and
# translations other than Italian/English are not installed. Licence files
# (copyright) are kept.
path-exclude /usr/share/doc/*
path-include /usr/share/doc/*/copyright
path-exclude /usr/share/man/*
path-exclude /usr/share/info/*
path-exclude /usr/share/help/*
path-exclude /usr/share/locale/*
path-include /usr/share/locale/it/*
path-include /usr/share/locale/en*
path-include /usr/share/locale/locale.alias
path-exclude /usr/share/qt6/translations/*
path-include /usr/share/qt6/translations/*_it.qm
path-include /usr/share/qt6/translations/*_en.qm
