[Unit]
Description=CyberDistro Sentinel: Suricata + Zeek, passive capture on the default route
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/sentinel-engines
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
